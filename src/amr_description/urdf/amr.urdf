<?xml version="1.0"?>

<robot name="my_amr">

    <!-- ===================================================== -->
    <!-- BASE LINK                                             -->
    <!-- ===================================================== -->

 <link name="base_link">

    <!-- Fusion model: appearance -->
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh
                filename="package://amr_description/meshes/visual/base_link_1.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
    </visual>

    <!-- Simple collision: physics -->
    <collision>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <geometry>
            <box size="0.50 0.40 0.20"/>
        </geometry>
    </collision>

    <!-- Physical properties -->
    <inertial>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>

        <mass value="10.0"/>

        <inertia
            ixx="0.1833"
            ixy="0.0"
            ixz="0.0"
            iyy="0.2833"
            iyz="0.0"
            izz="0.4167"/>
    </inertial>

</link>


    <!-- ===================================================== -->
    <!-- LEFT WHEEL                                            -->
    <!-- ===================================================== -->

    <link name="left_wheel">

        <visual>

            <origin
                xyz="0 0 0"
                rpy="1.5708 0 0"/>

            <geometry>

                <mesh
                    filename="package://amr_description/meshes/visual/Wheel_link_1.stl"
                    scale="0.001 0.001 0.001"/>

            </geometry>

        </visual>


        <collision>

            <origin
                xyz="0 0 0"
                rpy="1.5708 0 0"/>

            <geometry>

                <mesh
                    filename="package://amr_description/meshes/visual/Wheel_link_1.stl"
                    scale="0.001 0.001 0.001"/>

            </geometry>

        </collision>


        <inertial>

            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

            <mass value="1.0"/>

            <inertia
                ixx="0.01"
                ixy="0.0"
                ixz="0.0"
                iyy="0.01"
                iyz="0.0"
                izz="0.01"/>

        </inertial>

    </link>


    <!-- ===================================================== -->
    <!-- RIGHT WHEEL                                           -->
    <!-- ===================================================== -->

    <link name="right_wheel">

        <visual>

            <origin
                xyz="0 0 0"
                rpy="1.5708 0 0"/>

            <geometry>

                <mesh
                    filename="package://amr_description/meshes/visual/Wheel_link_1.stl"
                    scale="0.001 0.001 0.001"/>

            </geometry>

        </visual>


        <collision>

            <origin
                xyz="0 0 0"
                rpy="1.5708 0 0"/>

            <geometry>

                <mesh
                    filename="package://amr_description/meshes/visual/Wheel_link_1.stl"
                    scale="0.001 0.001 0.001"/>

            </geometry>

        </collision>


        <inertial>

            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

            <mass value="1.0"/>

            <inertia
                ixx="0.01"
                ixy="0.0"
                ixz="0.0"
                iyy="0.01"
                iyz="0.0"
                izz="0.01"/>

        </inertial>

    </link>


    <!-- ===================================================== -->
    <!-- LIDAR LINK                                            -->
    <!-- ===================================================== -->

    <link name="lidar_link">

        <visual>

            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

            <geometry>

                <mesh
                    filename="package://amr_description/meshes/visual/lidar_link_1.stl"
                    scale="0.001 0.001 0.001"/>

            </geometry>

        </visual>


        <collision>

            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

            <geometry>

                <mesh
                    filename="package://amr_description/meshes/visual/lidar_link_1.stl"
                    scale="0.001 0.001 0.001"/>

            </geometry>

        </collision>


        <inertial>

            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

            <mass value="0.5"/>

            <inertia
                ixx="0.005"
                ixy="0.0"
                ixz="0.0"
                iyy="0.005"
                iyz="0.0"
                izz="0.005"/>

        </inertial>

    </link>


    <!-- ===================================================== -->
    <!-- LEFT WHEEL JOINT                                      -->
    <!-- ===================================================== -->

    <joint
        name="left_wheel_joint"
        type="continuous">

        <parent link="base_link"/>

        <child link="left_wheel"/>

        <!-- CHANGE THIS POSITION TO MATCH YOUR CAD -->

        <origin
            xyz="0 0.02 0"
            rpy="0 0 0"/>

        <axis
            xyz="0 1 0"/>

    </joint>


    <!-- ===================================================== -->
    <!-- RIGHT WHEEL JOINT                                     -->
    <!-- ===================================================== -->

    <joint
        name="right_wheel_joint"
        type="continuous">

        <parent link="base_link"/>

        <child link="right_wheel"/>

        <!-- CHANGE THIS POSITION TO MATCH YOUR CAD -->

        <origin
            xyz="0 -0.02 0"
            rpy="0 0 0"/>

        <axis
            xyz="0 1 0"/>

    </joint>


    <!-- ===================================================== -->
    <!-- LIDAR JOINT                                           -->
    <!-- ===================================================== -->

    <joint
        name="lidar_joint"
        type="fixed">

        <parent link="base_link"/>

        <child link="lidar_link"/>

        <!-- CHANGE THIS POSITION TO MATCH YOUR CAD -->

        <origin
            xyz="0 0 0.01"
            rpy="0 0 0"/>

    </joint>
    <gazebo>

    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

        <left_joint>left_wheel_joint</left_joint>

        <right_joint>right_wheel_joint</right_joint>

        <wheel_separation>0.40</wheel_separation>

        <wheel_radius>0.08</wheel_radius>

        <topic>/cmd_vel</topic>

        <odom_topic>/odom</odom_topic>

        <frame_id>odom</frame_id>

        <child_frame_id>base_link</child_frame_id>

        <odom_publish_frequency>30</odom_publish_frequency>

    </plugin>

</gazebo>

</robot>